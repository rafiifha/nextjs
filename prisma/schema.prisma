generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  priceTypes  String[] // Array of price type names, e.g., ["dus", "pak", "item"] or ["bal", "kg"]
  products    Product[]
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  categoryId  Int      @default(1) // Default ke kategori pertama (akan dibuat via seed)
  category    Category @relation(fields: [categoryId], references: [id])
  image       String?  // URL gambar produk (bisa kosong)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  variants    ProductVariant[]
  items       OrderItem[]
}

model ProductVariant {
  id          Int      @id @default(autoincrement())
  productId   Int
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceType   String   // "dus", "pak", "item", "bal", "kg", etc.
  price       Int?     // Harga untuk jenis ini (bisa kosong)
  stockOnline  Int?    // Stok online (ditampilkan ke pelanggan)
  stockOffline Int?    // Stok offline (ditampilkan ke kasir)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  items       OrderItem[] @relation("VariantOrderItems")
}

model Order {
  id            Int         @id @default(autoincrement())
  customerName  String
  customerPhone String
  userId        Int?        // FK ke User yang membuat pesanan
  user          User?       @relation(fields: [userId], references: [id])
  status        String      @default("pending") // pending, paid, processing, shipped, delivered, cancelled, expired
  totalHarga    Int
  discount      Int?        @default(0) // Diskon dalam rupiah
  cashReceived  Int?        // Uang yang diterima (untuk pembayaran tunai)
  change        Int?         // Kembalian (untuk pembayaran tunai)
  deliveryMethod String?
  shippingFee   Int?
  // Shipping fields
  shippingAddress  String?    // Alamat lengkap pengiriman
  shippingLat      Float?     // Latitude tujuan
  shippingLng      Float?     // Longitude tujuan
  shippingDistance  Float?    // Jarak dalam km
  shippingZone     Int?      // Zona (1, 2, 3)

  shippingNotes    String?   // Catatan untuk kurir
  courierId        Int?      // FK ke User dengan role 'kurir'
  courier          User?     @relation("CourierOrders", fields: [courierId], references: [id])
  shippedAt        DateTime? // Waktu mulai dikirim
  deliveredAt      DateTime? // Waktu sampai
  proofOfDelivery  String?   // URL foto bukti pengiriman dari kurir
  paymentMethod String?     // e.g., 'qris', 'bca_va'
  paymentNumber String?     // VA number or QRIS string
  paymentFee    Int?        // Admin fee from Pakasir
  expiredAt     DateTime?   // Waktu kedaluwarsa pembayaran
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  items         OrderItem[]
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int
  variantId Int?   // ID varian harga yang dipilih
  priceType String  @default("dus") // Jenis harga: "dus", "pak", "item", "bal", "kg", etc.
  quantity  Int
  price     Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation("VariantOrderItems", fields: [variantId], references: [id])
}

model User {
  id               Int               @id @default(autoincrement())
  name             String
  email            String?           @unique
  phone            String?           @unique
  password         String
  role             String            @default("admin") // admin, kasir, kurir, customer
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  orders           Order[]
  courierOrders    Order[]           @relation("CourierOrders")
  otpVerifications OtpVerification[]
}

model OtpVerification {
  id        Int      @id @default(autoincrement())
  phone     String
  code      String
  type      String   // "register" atau "forgot_password"
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    Int?     // Nullable: null saat register (user belum ada), terisi saat forgot_password
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phone, type])
  @@index([userId])
}
