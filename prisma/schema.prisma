generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  priceTypes  String[] // Array of price type names, e.g., ["dus", "pak", "item"] or ["bal", "kg"]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  products    Product[]
  productRequests ProductRequest[]
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  categoryId  Int      @default(1) // Default ke kategori pertama (akan dibuat via seed)
  category    Category @relation(fields: [categoryId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  variants    ProductVariant[]
  items       OrderItem[]
}

model ProductVariant {
  id          Int      @id @default(autoincrement())
  productId   Int
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceType   String   // "dus", "pak", "item", "bal", "kg", etc.
  price       Int?     // Harga untuk jenis ini (bisa kosong)
  stock_online Int?    // Stok online untuk varian ini (bisa kosong)
  stock_offline Int?   // Stok offline untuk varian ini (bisa kosong)
  length      Int?     // Panjang dalam cm (untuk pengiriman)
  width       Int?     // Lebar dalam cm (untuk pengiriman)
  height      Int?     // Tinggi dalam cm (untuk pengiriman)
  weight      Int?     // Berat dalam gram (untuk pengiriman)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  items       OrderItem[] @relation("VariantOrderItems")
}

model Order {
  id            Int         @id @default(autoincrement())
  customerName  String
  customerPhone String
  status        String      @default("pending") // pending, paid, processing, delivered, cancelled, expired
  totalHarga    Int
  discount      Int?        @default(0) // Diskon dalam rupiah
  cashReceived  Int?        // Uang yang diterima (untuk pembayaran tunai)
  change        Int?         // Kembalian (untuk pembayaran tunai)
  deliveryMethod String?
  shippingFee   Int?
  trackingId    String?     // Biteship tracking ID
  waybillId     String?     // Biteship waybill ID
  biteshipOrderId String?   // Biteship order ID
  expiredAt     DateTime?   // Waktu kedaluwarsa pembayaran
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  items         OrderItem[]
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int
  variantId Int?   // ID varian harga yang dipilih
  priceType String  @default("dus") // Jenis harga: "dus", "pak", "item", "bal", "kg", etc.
  quantity  Int
  price     Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation("VariantOrderItems", fields: [variantId], references: [id])
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String?  @unique
  phone     String?  @unique
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
}

model ProductRequest {
  id            Int      @id @default(autoincrement())
  productName   String   // Nama produk yang diminta
  categoryId    Int?     // ID kategori (opsional)
  category      Category? @relation(fields: [categoryId], references: [id])
  customerName  String   // Nama pelanggan yang meminta
  customerPhone String   // Nomor telepon pelanggan
  notes         String?  // Catatan tambahan (opsional)
  status        String   @default("pending") // pending, approved, rejected, completed
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}


